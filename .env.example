PORT=3100
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=conc_care
DB_USER=conc_care_app
DB_PASSWORD=replace-with-a-strong-password
DB_POOL_SIZE=10
# Enable verified TLS for a remote MySQL server.
DB_SSL=false
DB_SSL_CA=
BUSINESS_TIMEZONE=Australia/Perth
# disabled is safe: messages are recorded as disabled, never delivered.
MAIL_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
OFFICE_EMAIL=
# Only set to 1 behind a trusted single reverse proxy.
TRUST_PROXY=0
