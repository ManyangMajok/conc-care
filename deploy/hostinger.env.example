NODE_ENV=production
NPM_CONFIG_INCLUDE=dev
HOST=0.0.0.0
PORT=3000
APP_ORIGIN=https://conccaregroup.com.au
DB_HOST=localhost
DB_PORT=3306
DB_NAME=replace_with_full_hpanel_database_name
DB_USER=replace_with_full_hpanel_database_username
DB_PASSWORD=replace_in_hpanel_only
DB_POOL_SIZE=5
DB_SSL=false
BUSINESS_TIMEZONE=Australia/Perth
TRUST_PROXY=1
MAIL_MODE=disabled
# First deployment only. Remove INITIAL_ADMIN_* and set false after setup.
SETUP_DATABASE=true
INITIAL_ADMIN_EMAIL=replace_with_your_admin_email
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PASSWORD=replace_in_hpanel_with_a_new_strong_password
